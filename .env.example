# Copy this file to `.env` and paste your own free Groq API key.
#
#   1. Create a free key at https://console.groq.com/keys
#      (Log in -> API Keys -> Create API Key -> copy the key).
#   2. Copy this file:   cp .env.example .env
#   3. Replace the placeholder below with your real key.
#
# `.env` is git-ignored and must never be committed or shared. No real key is
# bundled with this project — you must supply your own.
GROQ_API_KEY=your_key_here
